# ============================================================
# 认证 (部署到公网服务器时必须设置!否则任何人都能读写/删除你的笔记)
# ============================================================
# 部署域名(docker-compose 里的 Caddy 用它签发 HTTPS 证书)。本地测试可填 localhost。
WIKI_DOMAIN=localhost

# MCP (/mcp) 的 Bearer token —— Cursor 等远程客户端用它连接。建议用随机长串:
#   openssl rand -hex 32
WIKI_TOKEN=

# Web UI + REST API 的 Basic Auth 密码。设了才会要求登录 (用户名默认 wiki)。
WIKI_USER=wiki
WIKI_PASSWORD=

# 反向代理:让 req.ip 取到真实客户端 IP(限流按 IP 生效)。
# 同机反代(Caddy/Nginx)用默认 loopback 即可;其它可填 true / IP / 网段。
# WIKI_TRUST_PROXY=loopback

# 限流(每分钟每 IP 次数上限)。
# WIKI_MCP_RATE_LIMIT=120
# WIKI_UPLOAD_RATE_LIMIT=30

# ============================================================
# 自动分类 (OpenAI 兼容接口:OpenAI / DeepSeek / 通义 / 自建均可)
# ============================================================
# 填了才会启用「保存时自动归类」和「自动归类」按钮。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ============================================================
# 语义检索 / 「问知识库」(RAG):向量 embedding 接口
# ============================================================
# 默认复用上面的 LLM_BASE_URL / LLM_API_KEY,只需确认服务商有 embeddings 接口。
#   通义 DashScope:  默认可用,模型 text-embedding-v3(默认值,无需填)
#   OpenAI:          EMBED_MODEL=text-embedding-3-small
#   DeepSeek:        暂无 embeddings,需单独指定一个有该接口的服务:
#     EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#     EMBED_API_KEY=sk-...
#     EMBED_MODEL=text-embedding-v3
# 三项留空则复用 LLM_* 并用默认模型 text-embedding-v3。
# EMBED_BASE_URL=
# EMBED_API_KEY=
# EMBED_MODEL=text-embedding-v3

# ============================================================
# 图片对象存储配置 (S3 兼容:AWS S3 / Cloudflare R2 / 阿里云 OSS / MinIO 通用)
# ============================================================
# 复制为 .env 并填入真实值。.env 已被 .gitignore 忽略,不会提交。

# --- 必填 ---
S3_BUCKET=my-wiki-images
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key

# --- 强烈建议:图片对外访问的 URL 前缀 (CDN 或桶的公开域名) ---
# markdown 里写入的图片链接 = S3_PUBLIC_BASE_URL + / + 文件 key
S3_PUBLIC_BASE_URL=https://images.example.com

# --- 按服务商填写 ---
# Cloudflare R2:  S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com  S3_REGION=auto
# 阿里云 OSS:      S3_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com          S3_REGION=oss-cn-hangzhou
# MinIO:          S3_ENDPOINT=http://127.0.0.1:9000  S3_FORCE_PATH_STYLE=true
# AWS S3:         可留空 S3_ENDPOINT,填 S3_REGION=us-east-1
S3_ENDPOINT=
S3_REGION=auto
# S3_FORCE_PATH_STYLE=true

# --- 可选 ---
# 桶内 key 前缀 (默认 wiki-images/)
S3_KEY_PREFIX=wiki-images/
# 单文件大小上限,字节 (默认 15MB)
# S3_MAX_UPLOAD_BYTES=15728640
